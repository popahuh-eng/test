# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_platform

# Redis
REDIS_URL=redis://localhost:6379

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Market Data Provider
# Options: twelvedata, ccxt, demo
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=

# News Provider
# Options: newsapi, demo
NEWS_PROVIDER=demo
NEWS_API_KEY=

# Social Provider (optional)
# Options: twitter, disabled
SOCIAL_PROVIDER=disabled
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Auth
JWT_SECRET=change-this-to-a-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Trading Safety (NEVER change to true without full live trading setup)
LIVE_TRADING_ENABLED=false

# Default User Settings
DEFAULT_RISK_PER_TRADE=1
DEFAULT_MIN_CONFIDENCE=0.70
DEFAULT_MIN_RR=2.0

# Signal Engine
SIGNAL_COOLDOWN_MINUTES=60
MAX_SIGNALS_PER_SYMBOL_PER_HOUR=2

# Data Retention (days)
NEWS_RETENTION_DAYS=90
SOCIAL_RETENTION_DAYS=30
CANDLE_RETENTION_DAYS=730

# Demo Mode
DEMO_MODE=false
